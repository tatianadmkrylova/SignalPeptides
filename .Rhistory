library(readr)
table_merged_for_analysis <- read_csv("Documents/STAGE_LIRMM/Travail/table_merged_for_analysis.csv")
View(table_merged_for_analysis)
library(readr)
hosts <- read_csv("Documents/STAGE_LIRMM/Travail/hosts.csv")
View(hosts)
merged2 <- merge(
table_merged_for_analysis,
hosts[, c("Host")],
by = "ProteinId",
all.x = TRUE
)
merged2 <- merge(
table_merged_for_analysis,
hosts[, c("Host")],
by.x = "ProteinId",
by.y = "ProteinId",
all.x = TRUE
)
merged2 <- merge(
table_merged_for_analysis,
hosts[, c("ProteinId","Host")],
by.x = "ProteinId",
by.y = "ProteinId",
all.x = TRUE
)
View(merged2)
merged2$humanHost <- ifelse(
!is.na(merged2$Host) & grepl("Human", merged2$Host, ignore.case = TRUE),
"yes",
"no"
)
merged2$humanHost <- ifelse(
!is.na(merged2$Host) & grepl("Homo sapiens", merged2$Host, ignore.case = TRUE),
"yes",
"no"
)
summary(merged2$humanHost)
sum(merged2$humanHost)
table(merged2$humanHost)
library(ggplot2)
model <- lm(merged2$Pos_end ~ merged2$Length, data = merged2)
merged2_copy <- merged2
merged_copy2$predicted <- predict(model)
merged2_copy <- merged2
merged_copy2$predicted <- predict(model)
model <- lm(merged2$Pos_end ~ merged2$Length, data = merged2_copy)
merged2_copy <- merged2
merged_copy2$predicted <- predict(model)
merged_copy <- merged2
model <- lm(merged2$Pos_end ~ merged2$Length, data = merged_copy)
merged_copy2$predicted <- predict(model)
merged_copy <- merged2
model <- lm(merged2$Pos_end ~ merged2$Length, data = merged_copy)
merged_copy$predicted <- predict(model)
merged_copy$residuals <- merged_copy$y - merged_copy$predicted
rmse <- sqrt(mean(merged_copy$residuals^2, na.rm = TRUE))
ggplot(merged_copy, aes(x = x, y = y)) +
geom_point() +
geom_smooth(method = "lm", se = TRUE) +
labs(
title = paste("Linear regression, RMSE =", round(rmse, 3)),
x = "x",
y = "y"
)
library("ggpubr")
