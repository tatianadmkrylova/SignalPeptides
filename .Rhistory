add = "reg.line",add.params = list(color = "blue", fill = "lightgray"),
conf.int = TRUE)
df3
df3 + stat_cor(method = "pearson", label.x = 0.15, label.y = 0.5)
df3 + stat_cor(method = "pearson", label.x = 0, label.y = 100)
